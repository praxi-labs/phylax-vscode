{
  "name": "phylax",
  "displayName": "Phylax",
  "description": "See which dependencies are unsafe without leaving your editor. Phylax marks any package whose verdict is not ALLOW in the Problems panel.",
  "version": "0.1.0",
  "publisher": "phylax",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/praxi-labs/phylax-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/praxi-labs/phylax-vscode/issues"
  },
  "homepage": "https://phyi.dev",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "supply-chain",
    "dependencies",
    "sbom",
    "vulnerability",
    "npm",
    "pypi",
    "attestation"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/package-lock.json",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/pyproject.toml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "phylax.signIn",
        "title": "Phylax: Sign in"
      },
      {
        "command": "phylax.scanWorkspace",
        "title": "Phylax: Scan workspace dependencies"
      },
      {
        "command": "phylax.clearDiagnostics",
        "title": "Phylax: Clear diagnostics"
      }
    ],
    "configuration": {
      "title": "Phylax",
      "properties": {
        "phylax.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Phylax verification."
        },
        "phylax.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Verify dependencies when a manifest is opened."
        },
        "phylax.policyLevel": {
          "type": "string",
          "enum": [
            "lenient",
            "moderate",
            "strict"
          ],
          "default": "moderate",
          "description": "Which verdicts become Problems panel entries. Lenient reports only BLOCK, moderate adds WARN, strict reports everything."
        },
        "phylax.showInlineResults": {
          "type": "boolean",
          "default": true,
          "description": "Show trust verdicts inline in manifests."
        },
        "phylax.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Re-verify automatically when a manifest changes."
        },
        "phylax.policy": {
          "type": "string",
          "default": "",
          "description": "Named Phylax policy to evaluate against. Empty uses the organization default."
        },
        "phylax.baseUrl": {
          "type": "string",
          "default": "https://api.phyi.dev",
          "description": "Phylax API base URL."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=out/extension.js",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@phyi/sdk": "^0.1.0",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "galleryBanner": {
    "color": "#0D0D0D",
    "theme": "dark"
  },
  "qna": "https://github.com/praxi-labs/phylax-vscode/issues"
}
